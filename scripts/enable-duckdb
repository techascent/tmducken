#!/bin/bash

ARCHNAME="linux-amd64"
if [ "$(uname -sm)" == "Linux aarch64" ]; then
    ARCHNAME="linux-aarch64"
elif [ "$(uname)" == "Darwin" ]; then
    ARCHNAME="osx-universal"
fi

echo $ARCHNAME

if [ ! -e binaries ]; then
    wget https://github.com/duckdb/duckdb/releases/download/v1.5.5/libduckdb-$ARCHNAME.zip
    unzip libduckdb-$ARCHNAME.zip -d binaries
    rm libduckdb-$ARCHNAME.zip
fi

export DUCKDB_HOME="$(pwd)/binaries"
